{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cubby history --json",
  "description": "Recent runs, newest first, with how much of each was undone.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "v": {
            "const": 1
          },
          "run": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "run",
              "watch"
            ]
          },
          "source": {
            "type": "string"
          },
          "started": {
            "type": "string"
          },
          "finished": {
            "type": "string"
          },
          "moved": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error",
                "file"
              ]
            }
          },
          "extraction_failures": {
            "description": "Files whose content a converter broke on (timeout, crash, non-zero exit): sorted anyway by name and type, so not counted in failed. 0 in a record written before the count existed.",
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "undone": {
            "type": "boolean"
          },
          "undo": {
            "enum": [
              "undoable",
              "partly undone",
              "undone",
              "unknown"
            ]
          }
        },
        "required": [
          "extraction_failures",
          "failed",
          "failures",
          "finished",
          "mode",
          "moved",
          "run",
          "source",
          "started",
          "status",
          "undo",
          "undone",
          "v",
          "version"
        ]
      }
    }
  },
  "required": [
    "runs",
    "version"
  ]
}

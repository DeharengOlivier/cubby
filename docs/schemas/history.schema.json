{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cubby history --json",
  "description": "Recent runs, newest first, with how much of each was undone.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "v": {
            "const": 1
          },
          "run": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "run",
              "watch"
            ]
          },
          "source": {
            "type": "string"
          },
          "started": {
            "type": "string"
          },
          "finished": {
            "type": "string"
          },
          "moved": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error",
                "file"
              ]
            }
          },
          "extraction_failures": {
            "description": "Files whose content was lost: every converter that tried broke (timeout, crash, non-zero exit) and none gave usable text. Sorted anyway by name and type, so not counted in failed. A file another converter rescued is not counted. 0 in a record written before the count existed.",
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "undone": {
            "type": "boolean"
          },
          "undo": {
            "enum": [
              "undoable",
              "partly undone",
              "undone",
              "unknown"
            ]
          },
          "duration_ms": {
            "description": "How long the run took, in milliseconds. Null in a record written before 0.5.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "waiting": {
            "description": "Files the run left because they had not settled yet. Null in a record written before 0.5.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "extraction_failures",
          "failed",
          "failures",
          "finished",
          "mode",
          "moved",
          "run",
          "source",
          "started",
          "status",
          "undo",
          "undone",
          "v",
          "version"
        ]
      }
    }
  },
  "required": [
    "runs",
    "version"
  ]
}

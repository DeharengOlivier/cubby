{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cubby plan --json",
  "description": "Where each file would go; nothing is moved.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "applied": {
      "type": "boolean"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "subdir": {
            "type": [
              "string",
              "null"
            ]
          },
          "renamed_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "enum": [
              "strong-ext",
              "name",
              "content",
              "type",
              "unsorted",
              null
            ]
          },
          "rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "moved_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "journaled": {
            "type": "boolean"
          },
          "duplicate_of": {
            "description": "With dedupe: the byte-identical file already filed, for which this entry is (or would be) deleted instead of moved. Null for a move.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "category",
          "duplicate_of",
          "error",
          "journaled",
          "moved_to",
          "name",
          "renamed_to",
          "rule",
          "source",
          "stage",
          "subdir"
        ]
      }
    },
    "left_alone": {
      "description": "Entries not sorted this time, with why: a download in progress, or (run only) too recent.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "reason"
        ]
      }
    },
    "blocked": {
      "description": "Names where a folder cubby files into should be, held by a file: files for that folder cannot be sorted until it is renamed or moved.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "applied",
    "blocked",
    "count",
    "failed",
    "items",
    "left_alone",
    "version"
  ]
}

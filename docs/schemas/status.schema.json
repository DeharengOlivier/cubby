{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cubby status --json",
  "description": "The agent's health; the command exits 1 when healthy is false.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "healthy": {
      "type": "boolean"
    },
    "agent": {
      "type": "object",
      "properties": {
        "manager": {
          "enum": [
            "launchd",
            "systemd",
            null
          ]
        },
        "installed": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_pass_age": {
          "type": [
            "number",
            "null"
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "live_pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "never_passed": {
          "type": "boolean"
        },
        "watching": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_pass": {
          "description": "The agent's last pass: its duration in seconds, the files it moved and failed, and those still settling. Null when there is no heartbeat, after a pause, or from a cubby before 0.3.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "moved": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "waiting": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "failed",
                "moved",
                "seconds",
                "waiting"
              ]
            }
          ]
        },
        "interval": {
          "description": "Seconds between passes, from the heartbeat (since 0.5). Null when there is no heartbeat.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "installed",
        "last_pass",
        "last_pass_age",
        "live_pid",
        "manager",
        "never_passed",
        "running",
        "stale",
        "unit",
        "watching"
      ]
    },
    "paused": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "since": {
              "type": "string"
            },
            "until": {
              "type": [
                "number",
                "null"
              ]
            },
            "damaged": {
              "type": "boolean"
            }
          },
          "required": [
            "damaged",
            "since",
            "until"
          ]
        }
      ]
    },
    "last_run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "const": 1
            },
            "run": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "run",
                "watch"
              ]
            },
            "source": {
              "type": "string"
            },
            "started": {
              "type": "string"
            },
            "finished": {
              "type": "string"
            },
            "moved": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "error",
                  "file"
                ]
              }
            },
            "extraction_failures": {
              "description": "Files whose content was lost: every converter that tried broke (timeout, crash, non-zero exit) and none gave usable text. Sorted anyway by name and type, so not counted in failed. A file another converter rescued is not counted. 0 in a record written before the count existed.",
              "type": "integer",
              "minimum": 0
            },
            "version": {
              "type": "string"
            },
            "status": {
              "enum": [
                "ok",
                "partial",
                "failed"
              ]
            },
            "duration_ms": {
              "description": "How long the run took, in milliseconds. Null in a record written before 0.5.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "waiting": {
              "description": "Files the run left because they had not settled yet. Null in a record written before 0.5.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "extraction_failures",
            "failed",
            "failures",
            "finished",
            "mode",
            "moved",
            "run",
            "source",
            "started",
            "status",
            "v",
            "version"
          ]
        }
      ]
    },
    "log": {
      "type": "string"
    },
    "activity": {
      "description": "Runs that finished in the last `hours` hours (local time), with their failures grouped by kind of error, the file names left out, the most frequent first.",
      "type": "object",
      "properties": {
        "hours": {
          "type": "integer",
          "minimum": 1
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "moved": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "extraction_failures": {
          "description": "Files of those runs whose content was lost: every converter that tried broke (timeout, crash, non-zero exit) and none gave usable text. Sorted anyway by name and type, so not counted in failed.",
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "runs": {
                "type": "integer",
                "minimum": 1
              },
              "last_seen": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "count",
              "files",
              "kind",
              "last_seen",
              "runs",
              "versions"
            ]
          }
        },
        "complete": {
          "description": "False when the ledger holds as many runs as it keeps (2000) and none older than the window: runs of the window may have been dropped. A hint, not a proof.",
          "type": "boolean"
        },
        "pass_ms": {
          "description": "Run durations of the window, in milliseconds, nearest rank, over the runs that recorded one (since 0.5). Only runs that moved or failed a file are recorded. Null when none did.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "p50": {
                  "type": "integer",
                  "minimum": 0
                },
                "p95": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "count",
                "max",
                "p50",
                "p95"
              ]
            }
          ]
        },
        "backlog": {
          "description": "Files left to settle by the runs of the window: the oldest run's count, the newest's and the largest (since 0.5). Null when no run of the window recorded it.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "first": {
                  "type": "integer",
                  "minimum": 0
                },
                "last": {
                  "type": "integer",
                  "minimum": 0
                },
                "peak": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "first",
                "last",
                "peak"
              ]
            }
          ]
        },
        "saturation": {
          "description": "pass_ms.p95 as a share of the interval between passes (0.1 is 10 %), since 0.5. Null without a timed run or a heartbeat.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "complete",
        "errors",
        "extraction_failures",
        "failed",
        "hours",
        "moved",
        "runs"
      ]
    },
    "live": {
      "description": "Liveness (since 0.5): an agent process is alive and passing, going by the service manager and the heartbeat.",
      "type": "boolean"
    },
    "readiness": {
      "description": "Readiness (since 0.5): whether the agent can sort now. Not ready when a problem stops it or it is paused. healthy is false when an installed or live agent has a problem; a pause alone keeps it true.",
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "problems": {
          "description": "What stops the sorting, apart from a pause: the watched folder missing, unreadable or unwritable, the state folder unwritable, a file where a category folder goes, a config error.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "degraded": {
          "description": "Formats (extensions) no installed converter reads: such files are sorted by name and type only. Empty when content_scan is off.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "degraded",
        "problems",
        "ready"
      ]
    }
  },
  "required": [
    "activity",
    "agent",
    "healthy",
    "last_run",
    "log",
    "paused",
    "version"
  ]
}
